# 底座接入模板：复制到新底座 .githooks/pre-commit（chmod +x + git config core.hooksPath .githooks）
# 与 gen-params.py 同源（fullstack-param-protocol），改这里 → 各底座同步 vendored

#!/usr/bin/env bash
# pre-commit：best-effort 重新生成 params.json（不拦截提交；CI 才是硬门槛）。
# 需 copier 环境；解析器：uv run --with copier（失败则回退）→ copier 工具 python。
# 接入：git config core.hooksPath .githooks
set -u
# 仓库根从钩子自身位置推导（不依赖 CWD）：.githooks/pre-commit → 上一级
cd "$(cd "$(dirname "$0")" && pwd)/.." || exit 0

regenerate() {
  python_bin="$1"
  "$python_bin" bin/gen-params.py --template-dir template --output params.json --quiet
}

if command -v uv >/dev/null 2>&1 \
  && uv run --quiet --with copier python bin/gen-params.py \
       --template-dir template --output params.json --quiet 2>/dev/null; then
  echo "✓ params.json 已与 copier.yml 同步"
elif [ -x /home/jeff/.local/share/uv/tools/copier/bin/python ] \
  && regenerate /home/jeff/.local/share/uv/tools/copier/bin/python; then
  echo "✓ params.json 已与 copier.yml 同步"
else
  echo "⚠️ params.json 生成失败（忽略提交，CI 会硬校验）"
fi
exit 0
